HOST=127.0.0.1
PORT=8660
SUPABASE_URL=https://blockwise.example
# Compose-only host paths; the service receives fixed container paths.
CONTROL_EDGE_IMAGE=ghcr.io/stevenshelley58-afk/blockwise-control-edge:merged-sha@sha256:REPLACE_WITH_PUBLISHED_DIGEST
CONTROL_EDGE_INTERNAL_AUTH_HOST_FILE=/etc/blockwise/customer-ops/secrets/internal-auth
CONTROL_EDGE_SUPABASE_SERVICE_ROLE_HOST_FILE=/etc/blockwise/customer-ops/secrets/supabase-service-role
CONTROL_EDGE_EXECUTOR_SECRET_HOST_FILE=/etc/blockwise/customer-ops/secrets/action-executor
BLOCKWISE_INTERNAL_AUTH_SECRET_FILE=/run/secrets/internal-auth
SUPABASE_SERVICE_ROLE_KEY_FILE=/run/secrets/supabase-service-role
BLOCKWISE_ACTION_EXECUTOR_URL=https://blockwise.example
BLOCKWISE_ACTION_EXECUTOR_SECRET_FILE=/run/secrets/action-executor
CONTROL_EDGE_MAX_BODY_BYTES=131072
CONTROL_EDGE_REPLAY_WINDOW_SECONDS=300
CONTROL_EDGE_WORKER_ENABLED=false
CONTROL_EDGE_WORKER_INTERVAL_MS=1000
