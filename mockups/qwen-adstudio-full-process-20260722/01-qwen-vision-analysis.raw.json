{
  "name": "Just Listed - Modern Home",
  "goal": "seller_leads",
  "offerId": "just_listed_modern_home",
  "audienceIntent": "home_seller",
  "category": "listing_promotion",
  "tags": [
    "modern",
    "luxury",
    "pool",
    "contemporary"
  ],
  "inputs": {
    "images": [
      {
        "key": "property_photo",
        "label": "Property exterior photo (showing pool, patio, and architecture)",
        "required": true,
        "aspect": "landscape",
        "description": "High-resolution photo of the listed property’s outdoor living area, including pool, modern furniture, and architectural features as shown"
      },
      {
        "key": "agency_logo",
        "label": "Agency wordmark/logo (e.g., 'REALLYGREATSITE')",
        "required": true,
        "aspect": "square",
        "description": "Brand logo/wordmark to replace 'REALLYGREATSITE' at top; must be clean, legible, and centered"
      }
    ],
    "text": [
      {
        "key": "headline",
        "label": "Headline text",
        "maxLength": 20,
        "sample": "JUST LISTED",
        "required": true
      },
      {
        "key": "address",
        "label": "Property address",
        "maxLength": 60,
        "sample": "123 ANYWHERE ST, ANY CITY, ST 12345",
        "required": true
      },
      {
        "key": "phone",
        "label": "Contact phone number",
        "maxLength": 14,
        "sample": "123-456-7890",
        "required": true
      },
      {
        "key": "website",
        "label": "Agency website URL",
        "maxLength": 50,
        "sample": "www.reallygreatsite.com",
        "required": true
      }
    ]
  },
  "classification": {
    "ad_type": "static_listing_ad",
    "primary_intent": "generate_inquiry",
    "property_or_agent_focus": "property"
  }
}
