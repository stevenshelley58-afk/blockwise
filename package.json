{
  "name": "blockwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "adstudio:build-type-specs": "node scripts/build/font-corpus/adstudio-type-specs.mjs",
    "adstudio:build-type-regions": "node scripts/build/font-corpus/adstudio-type-specs.mjs --regions-only",
    "adstudio:build-runtime-fonts": "node scripts/build/font-corpus/build-runtime-fonts.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts tests/**/*.test.ts tests/**/*.test.mjs",
    "test:db": "npx supabase db reset --local && npx supabase test db",
    "test:db:adstudio-revision-backfill": "node scripts/verify/adstudio-creative-revision-backfill.mjs",
    "test:hard-reset": "node --test tests/hard-reset/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:preview": "node scripts/require-preview-e2e-env.mjs && playwright test",
    "test:e2e:hard-reset": "playwright test e2e/meta-ad-library-card.spec.ts",
    "test:research": "node --test tests/research-engine/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:nul": "node scripts/check-no-nul.mjs",
    "check": "npm run check:nul && npm run test && npm run typecheck",
    "verify:hard-reset": "node scripts/verify/hard-reset-static.mjs && node scripts/verify/adstudio-templates.mjs && node --test tests/hard-reset/*.test.ts",
    "verify-env": "node scripts/verify-env.mjs",
    "verify-env:first-tester": "node scripts/verify-env.mjs --first-tester",
    "adstudio:create-template": "node scripts/adstudio/create-template.mjs",
    "adstudio:template-quality": "node scripts/adstudio/template-quality.mjs",
    "adstudio:build-display-variants": "node scripts/adstudio/build-display-variants.mjs",
    "seed:test-users": "node scripts/seed-test-users.mjs"
  },
  "dependencies": {
    "@sentry/core": "^10.69.0",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.0.0",
    "recharts": "^3.8.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@playwright/test": "^1.53.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.1",
    "google-font-metadata": "^6.0.8",
    "opentype.js": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "$sharp"
  }
}
