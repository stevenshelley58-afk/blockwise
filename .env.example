NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_key

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_IDS_JSON=
STRIPE_ALLOW_PROMOTION_CODES=false

OPENAI_API_KEY=replace_me
GOOGLE_AI_API_KEY=replace_me
HERMES_SUPABASE_URL=https://example.supabase.co
HERMES_SUPABASE_SECRET_KEY=
HERMES_SUPABASE_SERVICE_ROLE_KEY=
HERMES_BASE_IMAGE=ghcr.io/nousresearch/hermes-agent:v2026.5.29.2
HERMES_HOST_PORT=8081
HERMES_DEFAULT_MODEL=gpt-5.5
HERMES_MODELS_JSON={}
HERMES_CONTENT_DEFAULT_MODEL=gpt-5.5
HERMES_RESEARCH_MODE=maintain
HERMES_BUILD_CONCURRENCY=4
HERMES_MAINTAIN_CONCURRENCY=1
HERMES_COLLECTION_INTERVAL_SECONDS=900
HERMES_DAILY_SPEND_LIMIT_USD=25
BLOCKWISE_RESEARCH_RUNTIME_ENABLED=true
HERMES_QUEUE_LOOP_INTERVAL_MS=60000
HERMES_RESEARCH_TARGET_POSTCODES=6008,6000,6005,6006,6007,6009,6010,6011,6014,6015,6016,6017,6018,6019,6020,6050,6051,6052,6151,6152,6153,6158,6159,6160,6166
HERMES_RESEARCH_SUPERVISOR_POLICY_LIMIT=50
HERMES_META_CAPTURE_RESULTS_LIMIT=250
HERMES_RESEARCH_AD_CREATIVES_BUCKET=research-ad-creatives
HERMES_RESEARCH_SCREENSHOTS_BUCKET=research-screenshots
HERMES_RESEARCH_RAW_EVIDENCE_BUCKET=research-raw-evidence
BLOCKWISE_OPENAI_TEXT_MODEL=gpt-5.5
BLOCKWISE_OPENAI_IMAGE_MODEL=gpt-image-2

TRIGGER_SECRET_KEY=replace_me
TRIGGER_PROJECT_ID=proj_replace_me
# Ad Studio template generation normally runs as an async trigger.dev job (202 + polling).
# Set to 1 to force the synchronous in-route fallback even when TRIGGER_SECRET_KEY is set (local/dev only).
ADSTUDIO_SYNC_GENERATE=

META_APP_ID=replace_me
META_APP_SECRET=replace_me
META_AD_LIBRARY_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_ADS_DEVELOPER_TOKEN=replace_me
GOOGLE_ADS_ENABLED=false
# Google Ads conversion tracking (optional — tag loads only when set + consent granted).
NEXT_PUBLIC_GOOGLE_ADS_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_PLACES_API_KEY=
BLOCKWISE_ENABLE_PROVIDER_WRITES=false

RESEND_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Operator console allowlist. Comma-separate emails when using the legacy fallback.
OPERATOR_EMAILS=

# Operator email console. Defaults read all @blockwise.sale mail and sends as steven@blockwise.sale.
OPERATOR_MAILBOX_DOMAIN=blockwise.sale
OPERATOR_MAILBOX_LABEL=All @blockwise.sale
OPERATOR_MAILBOX_ADDRESS=steven@blockwise.sale
OPERATOR_MAIL_FROM=Steven at Blockwise <steven@blockwise.sale>
OPERATOR_MAIL_REPLY_TO=steven@blockwise.sale

# Test/dev helpers only. Use a unique 16+ character value before running seed:test-users or E2E.
BLOCKWISE_DEV_PASSWORD=

# Monitor/demo controls.
META_MONITOR_BUDGET_AUD=
NEXT_PUBLIC_BLOCKWISE_SAMPLE_DATA=false

# Cloudflare Turnstile bot protection (required for signup form).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set TURNSTILE_SECRET_KEY in the Supabase Auth dashboard, not in the app env.

# Public site origin — used for canonical URLs, OpenGraph, sitemap & robots.
NEXT_PUBLIC_SITE_URL=https://blockwise.sale

# Demo-request notifications via Resend (optional).
# If unset, submissions still save to the demo_requests table; only the email alert is skipped.
# RESEND_API_KEY is defined above. DEMO_NOTIFY_FROM must be a verified sender on your domain.
DEMO_NOTIFY_FROM=Blockwise <notifications@blockwise.sale>
DEMO_NOTIFY_TO=hello@blockwise.sale

# Paid-service usage alerts (optional except CRON_SECRET; unset check/channel vars are skipped).
# Watchdog runs as a Vercel Cron route every 2 hours; see docs/runbooks/paid-service-alerts.md.
# CRON_SECRET is required for the watchdog route and detailed health responses.
ALERT_EMAIL_FROM=Blockwise Alerts <alerts@blockwise.sale>
ALERT_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ALERT_WHATSAPP_TO=
CRON_SECRET=
OPENAI_ADMIN_KEY=
OPENAI_MONTHLY_BUDGET_USD=50
VPS_HEALTH_URLS=
VERCEL_SPEND_WEBHOOK_SECRET=
