NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Private Blockwise research API hosted on the VPS. Never point these at a
# different product's Supabase project.
RESEARCH_API_URL=https://hermes.blockwise.sale/research
RESEARCH_API_SERVICE_KEY=replace_with_vps_service_role_jwt

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Regional recurring Prices must be created with explicit tax behavior:
# USD exclusive; AUD inclusive. The intro Coupons are once-only $/A$400 discounts.
STRIPE_SELF_SERVE_USD_PRICE_ID=
STRIPE_SELF_SERVE_AUD_PRICE_ID=
STRIPE_MANAGED_USD_PRICE_ID=
STRIPE_MANAGED_AUD_PRICE_ID=
STRIPE_SELF_SERVE_USD_INTRO_COUPON_ID=
STRIPE_SELF_SERVE_AUD_INTRO_COUPON_ID=
# Legacy billing scaffold fallbacks. New regional Checkout does not use these.
STRIPE_PRICE_ID=
STRIPE_PRICE_IDS_JSON=
STRIPE_ALLOW_PROMOTION_CODES=false

# Hosted onboarding scheduling. URLs remain usable when webhook automation is not configured.
CALCOM_ONBOARDING_URL_US=
CALCOM_ONBOARDING_URL_AU=
BOOKING_INVITATION_SECRET=
CALCOM_WEBHOOK_SECRET=

OPENAI_API_KEY=replace_me
OPENROUTER_API_KEY=replace_me
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional full URL override for non-standard Azure/OpenAI-compatible gateways.
AZURE_OPENAI_CHAT_COMPLETIONS_URL=
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_AI_GATEWAY_TOKEN=
# Hermes talks to the private VPS database for research state and to customer
# Supabase only for the app-required read model and creative media.
HERMES_RESEARCH_DB_PASSWORD=replace_with_url_safe_random_password
HERMES_RESEARCH_JWT_SECRET=replace_with_at_least_32_random_bytes
HERMES_RESEARCH_SERVICE_ROLE_KEY=replace_with_vps_service_role_jwt
HERMES_SUPABASE_URL=http://blockwise-research-gateway:3000
HERMES_SUPABASE_SECRET_KEY=
HERMES_SUPABASE_SERVICE_ROLE_KEY=replace_with_vps_service_role_jwt
HERMES_CUSTOMER_SUPABASE_URL=https://example.supabase.co
HERMES_CUSTOMER_SUPABASE_SECRET_KEY=replace_me
HERMES_CUSTOMER_SUPABASE_SERVICE_ROLE_KEY=
HERMES_CUSTOMER_READ_MODEL_PUBLISH_INTERVAL_SECONDS=300
HERMES_RAW_EVIDENCE_DIR=/opt/research-raw-evidence
HERMES_BASE_IMAGE=ghcr.io/nousresearch/hermes-agent:v2026.5.29.2
HERMES_PROVIDER=openrouter
HERMES_HOST_PORT=8081
HERMES_DEFAULT_MODEL=replace_with_openrouter_model_slug
HERMES_ESCALATION_MODEL=replace_with_openrouter_model_slug
HERMES_CONTENT_DEFAULT_MODEL=gpt-5.5
HERMES_RESEARCH_MODE=maintain
HERMES_BUILD_CONCURRENCY=4
HERMES_MAINTAIN_CONCURRENCY=1
HERMES_COLLECTION_INTERVAL_SECONDS=900
HERMES_DAILY_SPEND_LIMIT_USD=25
BLOCKWISE_RESEARCH_RUNTIME_ENABLED=true
HERMES_QUEUE_LOOP_INTERVAL_MS=60000
HERMES_RESEARCH_TARGET_POSTCODES=6008,6000,6005,6006,6007,6009,6010,6011,6014,6015,6016,6017,6018,6019,6020,6050,6051,6052,6151,6152,6153,6158,6159,6160,6166
HERMES_RESEARCH_SUPERVISOR_POLICY_LIMIT=50
HERMES_META_CAPTURE_RESULTS_LIMIT=250
HERMES_RESEARCH_AD_CREATIVES_BUCKET=research-ad-creatives
HERMES_RESEARCH_SCREENSHOTS_BUCKET=research-screenshots
HERMES_RESEARCH_RAW_EVIDENCE_BUCKET=research-raw-evidence
BLOCKWISE_OPENAI_TEXT_MODEL=gpt-5.5
BLOCKWISE_OPENAI_IMAGE_MODEL=gpt-image-2
BLOCKWISE_OPENROUTER_TEXT_MODEL=openai/gpt-5.5
BLOCKWISE_OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
BLOCKWISE_AZURE_OPENAI_TEXT_DEPLOYMENT=

META_APP_ID=replace_me
META_APP_SECRET=replace_me
META_AD_LIBRARY_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_ADS_DEVELOPER_TOKEN=replace_me
GOOGLE_ADS_ENABLED=false
# Google Ads conversion tracking (optional — tag loads only when set + consent granted).
NEXT_PUBLIC_GOOGLE_ADS_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_PLACES_API_KEY=
BLOCKWISE_ENABLE_PROVIDER_WRITES=false

# Progressive onboarding rollout gates. Keep all server-only and false/empty
# until the preceding phase passes on a Vercel Preview deployment.
BLOCKWISE_PROGRESSIVE_FOUNDATIONS_ENABLED=false
BLOCKWISE_PROGRESSIVE_ACTIVATION_ENABLED=false
BLOCKWISE_PROGRESSIVE_BILLING_ENABLED=false
BLOCKWISE_PROGRESSIVE_PUBLIC_LAUNCH_ENABLED=false
# Comma-separated subset of AU,US. Empty means no market is exposed.
BLOCKWISE_PROGRESSIVE_MARKETS=
# Integer 0-100. Exposure must be stable by workspace, never random per request.
BLOCKWISE_PROGRESSIVE_EXPOSURE_PERCENT=0

RESEND_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Operator console allowlist. Comma-separate emails when using the legacy fallback.
OPERATOR_EMAILS=

# Operator email console. Defaults read all @blockwise.sale mail and sends as steven@blockwise.sale.
OPERATOR_MAILBOX_DOMAIN=blockwise.sale
OPERATOR_MAILBOX_LABEL=All @blockwise.sale
OPERATOR_MAILBOX_ADDRESS=steven@blockwise.sale
OPERATOR_MAIL_FROM=Steven at Blockwise <steven@blockwise.sale>
OPERATOR_MAIL_REPLY_TO=steven@blockwise.sale

# Test/dev helpers only. Use a unique 16+ character value before running seed:test-users or E2E.
BLOCKWISE_DEV_PASSWORD=

# Monitor/demo controls.
META_MONITOR_BUDGET_AUD=
NEXT_PUBLIC_BLOCKWISE_SAMPLE_DATA=false

# Cloudflare Turnstile bot protection (required for signup form).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set TURNSTILE_SECRET_KEY in the Supabase Auth dashboard, not in the app env.

# Public site origin — used for canonical URLs, OpenGraph, sitemap & robots.
NEXT_PUBLIC_SITE_URL=https://blockwise.sale

# Demo-request notifications via Resend (optional).
# If unset, submissions still save to the demo_requests table; only the email alert is skipped.
# RESEND_API_KEY is defined above. DEMO_NOTIFY_FROM must be a verified sender on your domain.
DEMO_NOTIFY_FROM=Blockwise <notifications@blockwise.sale>
DEMO_NOTIFY_TO=hello@blockwise.sale

# Paid-service usage alerts (optional except CRON_SECRET; unset check/channel vars are skipped).
# Watchdog runs as a Vercel Cron route every 2 hours; see docs/runbooks/paid-service-alerts.md.
# CRON_SECRET is required for the watchdog route and detailed health responses.
ALERT_EMAIL_FROM=Blockwise Alerts <alerts@blockwise.sale>
ALERT_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ALERT_WHATSAPP_TO=
CRON_SECRET=
OPENAI_ADMIN_KEY=
OPENAI_MONTHLY_BUDGET_USD=50
OPENROUTER_MIN_CREDITS_USD=5
VPS_HEALTH_URLS=
VERCEL_SPEND_WEBHOOK_SECRET=

# ── AdStudio v2 rollout (plan §11) ── flags off = v1 path intact
# Gallery serves v2 ready templates; generation/edit routes accept v2. Test on a Preview deploy.
ADSTUDIO_TEMPLATES_V2=false
# Two-image asset_feed_spec creative path. Off until meta-publish-probe evidence on the dev ad account.
META_ASSET_FEED_ENABLED=true
# Dev-only ad account for scripts/verify/meta-publish-probe.mjs. Never set in production.
META_PROBE_AD_ACCOUNT_ID=

# Vercel Preview only: proves the napi-rs/canvas backend renders on the deploy runtime. Never set in production.
ADSTUDIO_RENDER_SMOKE=
