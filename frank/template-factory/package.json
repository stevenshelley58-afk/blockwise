{
  "name": "@blockwise/frank-template-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Frank template factory — private VPS service. Owns source ads, AI prompts, iteration history, rejected candidates, and model credentials. Emits signed TemplatePacks consumed by Blockwise.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@blockwise/ad-template-contract": "file:../../packages/ad-template-contract",
    "@blockwise/ad-template-renderer": "file:../../packages/ad-template-renderer",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
