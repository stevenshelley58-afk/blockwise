# The product and any future root-context builds must never send credentials or
# local state to a builder. Dockerfile-specific ignores may further narrow this.
.git
.git/**
.env*
!.env.example
.secrets
.secrets/**
node_modules
node_modules/**
.next
.next/**
.cache
.cache/**
.codex
.codex/**
.claude
.claude/**
.agents
.agents/**
artifacts
artifacts/**
playwright-report
playwright-report/**
test-results
test-results/**
docs
docs/**
tests
tests/**
e2e
e2e/**
hermes
hermes/**
frank
frank/**
worker
worker/**

# The customer Ad Radar needs the one canonical postcode directory at build
# time. Re-include only that file; all other Hermes runtime source stays out.
!hermes/
hermes/*
!hermes/data/
hermes/data/*
!hermes/data/au-postcodes.json
