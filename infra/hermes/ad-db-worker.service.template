[Unit]
Description=Hermes Ad DB worker (immutable first-fill release)
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStopSec=300
WorkingDirectory=@RELEASE_ROOT@/hermes/tools/research-runtime
Environment=HERMES_RAW_EVIDENCE_DIR=/srv/hermes/ad-db/raw-evidence
ReadWritePaths=/srv/hermes/ad-db /srv/hermes/ad-db/raw-evidence
User=hermes
Group=hermes
Environment=NODE_ENV=production
EnvironmentFile=/srv/hermes/secrets/ad-db-worker.env
ExecStart=@RELEASE_ROOT@/scripts/vps/hermes-ad-db-first-fill-launcher.sh @RELEASE_ROOT@
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
