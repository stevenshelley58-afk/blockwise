FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY hermes/tools/listing-scraper/package.json ./
RUN npm install --omit=dev

COPY hermes/tools/listing-scraper/index.mjs ./

EXPOSE 8650

CMD ["node", "index.mjs"]
