# Self-hosted Blockwise product contract.
# Copy this file to the VPS and inject real values from Infisical (or another
# secret manager). Never commit the copied .env file or put secrets in images.

BLOCKWISE_PRODUCT_DOMAIN=blockwise.sale
BLOCKWISE_DEPLOYMENT_ENV=production
BLOCKWISE_PUBLIC_URL=https://blockwise.sale
NEXT_PUBLIC_APP_URL=https://blockwise.sale
NEXT_PUBLIC_SITE_URL=https://blockwise.sale
BLOCKWISE_PRODUCT_COMPOSE_FILE=infra/coolify/docker-compose.product.yml
BLOCKWISE_PRODUCT_ENV_FILE=/srv/blockwise/product/.env
BLOCKWISE_BACKUP_DIR=/srv/blockwise/backups/product
# Frank's shared edge owns public 80/443. Product Caddy binds loopback only;
# the shared edge must persistently attach to blockwise-product and proxy the
# product hostname to product-caddy:80 (see the OSS migration runbook).
BLOCKWISE_PRODUCT_HTTP_BIND=127.0.0.1
BLOCKWISE_PRODUCT_HTTP_PORT=8080
BLOCKWISE_PRODUCT_HTTPS_BIND=127.0.0.1
BLOCKWISE_PRODUCT_HTTPS_PORT=8443
# Exact static address reserved for frank-caddy on blockwise-product; trust only this /32.
FRANK_PRODUCT_EDGE_IP=172.30.0.2
TRUSTED_PROXY_RANGES=172.30.0.2/32
BLOCKWISE_PRODUCT_NETWORK_SUBNET=172.30.0.0/24
BLOCKWISE_PRODUCT_NETWORK_IP_RANGE=172.30.0.128/25

BLOCKWISE_DB_NAME=blockwise
BLOCKWISE_DB_USER=postgres
# URL-safe characters only: [A-Za-z0-9._~-]. The value is embedded in service
# connection URLs and is parsed by the host-side migration scripts.
BLOCKWISE_DB_PASSWORD=replace-with-a-long-random-password
BLOCKWISE_DB_AUTHENTICATOR=authenticator
# URL-safe value: this is embedded in PGRST_DB_URI.
BLOCKWISE_DB_AUTHENTICATOR_PASSWORD=replace-with-a-separate-long-random-password
BLOCKWISE_DB_HOST=product-db
BLOCKWISE_DB_PORT=5432

# One JWT signing secret is shared by GoTrue, PostgREST, Storage API and the
# compatibility Supabase JS client. Generate a replacement before go-live.
BLOCKWISE_AUTH_JWT_SECRET=replace-with-a-32-byte-or-longer-random-secret
BLOCKWISE_AUTH_ANON_KEY=replace-with-a-signed-anon-jwt
BLOCKWISE_AUTH_SERVICE_KEY=replace-with-a-signed-service-role-jwt
BLOCKWISE_AUTH_OPERATOR_TOKEN=replace-with-a-separate-operator-token
BLOCKWISE_AUTH_SITE_URL=https://blockwise.sale
BLOCKWISE_AUTH_API_EXTERNAL_URL=https://blockwise.sale/auth/v1
BLOCKWISE_AUTH_URI_ALLOW_LIST=https://blockwise.sale/*,http://localhost:3000/*
BLOCKWISE_AUTH_JWT_EXP=3600
BLOCKWISE_AUTH_EXTERNAL_EMAIL_ENABLED=true
BLOCKWISE_AUTH_MAILER_AUTOCONFIRM=false
BLOCKWISE_AUTH_SMTP_HOST=
BLOCKWISE_AUTH_SMTP_PORT=587
BLOCKWISE_AUTH_SMTP_USER=
BLOCKWISE_AUTH_SMTP_PASS=
BLOCKWISE_AUTH_SMTP_ADMIN_EMAIL=
BLOCKWISE_AUTH_SMTP_SENDER_NAME=Blockwise

BLOCKWISE_STORAGE_FILE_SIZE_LIMIT=10485760
BLOCKWISE_STORAGE_SERVICE_KEY=${BLOCKWISE_AUTH_SERVICE_KEY}

BLOCKWISE_APP_IMAGE=ghcr.io/stevenshelley58-afk/blockwise-app:replace-with-git-sha
BLOCKWISE_WORKER_IMAGE=ghcr.io/stevenshelley58-afk/blockwise-worker:replace-with-git-sha@sha256:REPLACE_WITH_PUBLISHED_DIGEST
BLOCKWISE_GIT_SHA=0000000000000000000000000000000000000000
BLOCKWISE_BUILD_DATE=1970-01-01T00:00:00Z
BLOCKWISE_WORKER_EXPECTED_REVISION=

# Runtime compatibility names consumed by the existing OSS JS client. These
# point at the self-hosted Caddy endpoint, never at managed Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://blockwise.sale
NEXT_PUBLIC_RESEARCH_STORAGE_URL=https://hermes.blockwise.sale/research-media
NEXT_PUBLIC_SUPABASE_ANON_KEY=${BLOCKWISE_AUTH_ANON_KEY}
# Internal app readiness bypasses the public Frank edge during startup.
BLOCKWISE_READINESS_SUPABASE_URL=http://product-rest:3000
# Service-role key is mounted from SUPABASE_SERVICE_ROLE_KEY_HOST_FILE; do not
# put its value in this environment file.
TOKEN_ENCRYPTION_KEY=replace-with-the-existing-token-encryption-key

BLOCKWISE_REALTIME_ENABLED=true
BLOCKWISE_REALTIME_SECRET_KEY_BASE=replace-with-a-64-byte-or-longer-random-secret
BLOCKWISE_REALTIME_DB_ENC_KEY=replace-with-a-separate-32-byte-random-secret
BLOCKWISE_ENABLE_PROVIDER_WRITES=false
# Comma-separated workspace UUID canary list. Both gates must allow a workspace
# before Ad Studio publish or activation may write to Meta.
BLOCKWISE_META_PUBLISH_WORKSPACE_ALLOWLIST=

# Optional provider credentials. Core login, Ad Studio editing and durable
# saves do not contact these providers. Add real values only when enabling the
# corresponding provider; leave blank otherwise. Never use fake values.
OPENAI_API_KEY=
META_APP_ID=
META_APP_SECRET=
CRON_SECRET=
BLOCKWISE_INTERNAL_AUTH_SECRET=replace-in-infisical
# Temporary compatibility switch; keep disabled after all callers use HMAC.
BLOCKWISE_INTERNAL_ALLOW_LEGACY_BEARER=false

# Public values are inlined into the browser bundle at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_BLOCKWISE_SAMPLE_DATA=false
# Set true only after live operator AAL2 enrollment is proven; default remains fail-closed false.
OPERATOR_MFA_REQUIRED=false

# Application secrets and provider credentials are intentionally placeholders.
STRIPE_SECRET_KEY=replace-in-infisical
STRIPE_WEBHOOK_SECRET=replace-in-infisical
# Transactional mail: set EMAIL_PROVIDER explicitly (smtp or resend compatibility).
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
META_ACCESS_TOKEN=replace-in-infisical
GOOGLE_AI_API_KEY=replace-in-infisical
DEEPSEEK_API_KEY=replace-in-infisical
AZURE_OPENAI_API_KEY=replace-in-infisical
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_TEXT_DEPLOYMENT=
AZURE_OPENAI_CHAT_COMPLETIONS_URL=
BLOCKWISE_AZURE_OPENAI_TEXT_DEPLOYMENT=
GOOGLE_ADS_ENABLED=false
META_MONITOR_BUDGET_AUD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ALERT_WHATSAPP_TO=
VERCEL_SPEND_WEBHOOK_SECRET=replace-in-infisical

# Optional zero-loss cutover volume overrides
BLOCKWISE_DB_VOLUME_NAME=blockwise-product-db-data
BLOCKWISE_STORAGE_VOLUME_NAME=blockwise-product-storage-data

# Open-source Stalwart mail transport (mail profile is opt-in until DNS/TLS
# and the first domain/account have been configured). Stalwart generates its
# own settings, DKIM keys and mailbox data in the named volumes; keep the
# recovery credential in Infisical and remove it after bootstrap.
BLOCKWISE_MAIL_ENABLED=true
BLOCKWISE_MAIL_HOSTNAME=mail.blockwise.sale
BLOCKWISE_MAIL_DOMAIN=blockwise.sale
BLOCKWISE_MAIL_PUBLIC_URL=https://mail.blockwise.sale
BLOCKWISE_MAIL_SMTP_BIND=127.0.0.1
BLOCKWISE_MAIL_SMTP_PORT=25
BLOCKWISE_MAIL_SUBMISSION_BIND=127.0.0.1
# Host submission is intentionally loopback-only by default; GoTrue/outbox use
# product-mail:587 on the Docker network. Set an approved external bind/port
# only for a reviewed operator submission requirement.
BLOCKWISE_MAIL_SUBMISSION_PORT=1587
BLOCKWISE_MAIL_CONFIG_VOLUME_NAME=blockwise-product-mail-config
BLOCKWISE_MAIL_DATA_VOLUME_NAME=blockwise-product-mail-data
STALWART_RECOVERY_ADMIN=
STALWART_WEBHOOK_SECRET=

# Hermes OSS CRM provider secrets are bind-mounted read-only into
# product-worker. The container paths are fixed; these are host paths only.
MAUTIC_TOKEN_HOST_FILE=/srv/blockwise/secrets/mautic_token
MAUTIC_BASE_URL=
MAUTIC_CONTACT_TAG=
MAUTIC_LIFECYCLE_TAG=
MAUTIC_LIFECYCLE_FIELDS_JSON={"activation_stage":"text","booking_status":"text","booking_subject":"text"}
MAUTIC_LIFECYCLE_SEGMENTS_JSON={}
MAUTIC_LIFECYCLE_CAMPAIGNS_JSON={}
CHATWOOT_ENQUIRY_SOURCE_ID=
CHATWOOT_SUPPORT_SOURCE_ID=
CHATWOOT_GLOBAL_SOURCE_ID=
CHATWOOT_API_TOKEN_HOST_FILE=/srv/blockwise/secrets/chatwoot_api_token
BLOCKWISE_OPS_CORRELATION_KEY_HOST_FILE=/srv/blockwise/secrets/ops_correlation_key
SUPABASE_SERVICE_ROLE_KEY_HOST_FILE=/srv/blockwise/secrets/supabase_service_role_key

# GoTrue and the app outbox intentionally share the Stalwart SMTP transport,
# but retain separate credentials/configuration contracts. Generate the
# account/password on the VPS and inject both pairs through the secret manager.
BLOCKWISE_AUTH_SMTP_HOST=product-mail
BLOCKWISE_AUTH_SMTP_PORT=587
BLOCKWISE_AUTH_SMTP_USER=
BLOCKWISE_AUTH_SMTP_PASS=
BLOCKWISE_AUTH_SMTP_ADMIN_EMAIL=
BLOCKWISE_AUTH_SMTP_SENDER_NAME=Blockwise
# Non-secret receipt set true only after mail-validate.sh passes on the VPS.
BLOCKWISE_AUTH_SMTP_CONFIGURED=false
SMTP_HOST=product-mail
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
