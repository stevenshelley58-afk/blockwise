{
	servers {
		trusted_proxies static {$TRUSTED_PROXY_RANGES}
		trusted_proxies_strict
	}
}

# Frank's shared edge terminates public TLS. This internal router is explicitly
# HTTP-only so proxying to product-caddy:80 cannot trigger an HTTPS redirect
# loop or a second ACME certificate flow.
#
# Proxy chain: Frank edge -> product-caddy -> product-app.
#
# How the real client IP survives the chain (verified end to end):
#  1. Frank's edge resolves the customer from Cloudflare's CF-Connecting-IP (or
#     the connecting peer when the zone is not proxied) and forwards it as the
#     X-Forwarded-For entry for this hop.
#  2. This router trusts exactly one peer, {$TRUSTED_PROXY_RANGES} — the Frank
#     edge — and runs trusted_proxies_strict, which selects the LEFT-most
#     X-Forwarded-For entry rather than the right-most. Strict mode is what
#     makes {client_ip} the customer instead of the edge. Every entry a client
#     tries to inject before Frank is discarded, because Caddy only honours the
#     header when the immediate peer is trusted.
#  3. The resolved address is stamped into X-Blockwise-Client-IP, and the
#     application reads that header first (src/lib/client-ip.ts).
#
# Changing {$TRUSTED_PROXY_RANGES} to an address the edge does not use silently
# degrades every customer to the edge's container IP for rate limiting and
# audit attribution, with no error — it fails open, not closed.
http://{$BLOCKWISE_PRODUCT_DOMAIN} {
	encode zstd gzip

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	handle_path /rest/v1/* {
		reverse_proxy product-rest:3000
	}

	handle_path /auth/v1/* {
		reverse_proxy product-auth:9999
	}

	handle_path /storage/v1/* {
		reverse_proxy product-storage:5000
	}

	handle_path /realtime/v1/* {
		reverse_proxy product-realtime:4000
	}

	handle /api/* {
		reverse_proxy product-app:3000 {
			header_up X-Blockwise-Client-IP "{client_ip}"
		}
	}

	handle {
		reverse_proxy product-app:3000 {
			header_up X-Blockwise-Client-IP "{client_ip}"
		}
	}
}
