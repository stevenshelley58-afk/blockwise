# Isolated, secret-free Meta-connect UI preview. Build the Next standalone
# output first with BLOCKWISE_META_CONNECT_PREVIEW=true.
FROM node:22-slim AS runner
ARG GIT_SHA
LABEL org.opencontainers.image.revision=$GIT_SHA
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 BLOCKWISE_META_CONNECT_PREVIEW=true
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 nextjs

# Keep the preview image bounded. Add a public file only when the concept page
# references it; never copy the product's complete public asset catalogue.
COPY --chown=nextjs:nodejs public/brand/blockwise-logo.svg ./public/brand/blockwise-logo.svg
COPY --chown=nextjs:nodejs public/brand/blockwise-icon-midnight.svg ./public/brand/blockwise-icon-midnight.svg
# The five allowlisted instructional captures are sanitized derivatives tracked
# by docs/evidence/meta-partner-screenshots/manifest.json. Do not copy public/help
# wholesale: no other help media belongs in this isolated image.
COPY --chown=nextjs:nodejs public/help/meta/partner-access/01-partners.webp ./public/help/meta/partner-access/01-partners.webp
COPY --chown=nextjs:nodejs public/help/meta/partner-access/02-give-access-crop.webp ./public/help/meta/partner-access/02-give-access-crop.webp
COPY --chown=nextjs:nodejs public/help/meta/partner-access/02-give-access.webp ./public/help/meta/partner-access/02-give-access.webp
COPY --chown=nextjs:nodejs public/help/meta/partner-access/03-business-id.webp ./public/help/meta/partner-access/03-business-id.webp
COPY --chown=nextjs:nodejs public/help/meta/partner-access/04-assets-and-permissions.webp ./public/help/meta/partner-access/04-assets-and-permissions.webp
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:3000/meta-connect-preview/concept/meta-connect').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "server.js"]
