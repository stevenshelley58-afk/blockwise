# Copy to an operator-controlled file outside the checkout (mode 0600).
# Secret values belong in CUSTOMER_OPS_SECRETS_DIR and are generated/managed by
# scripts/vps/customer-ops-install.sh. Never commit the copied file.
CUSTOMER_OPS_SECRETS_DIR=/etc/blockwise/customer-ops/secrets
MAIL_PUBLIC_HOST=mail.example.com
# Must equal product Compose BLOCKWISE_MAIL_PUBLIC_HOST and the product-mail
# shared-network alias; the installer refuses any mismatch.
BLOCKWISE_MAIL_PUBLIC_HOST=mail.example.com
MAUTIC_HOST=crm.example.com
CHATWOOT_HOST=https://support.example.com
SNAGTIME_HOST=book.example.com
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
MAUTIC_SMTP_USER=mautic@example.com
CHATWOOT_SMTP_USER=support@example.com
SNAGTIME_SMTP_USER=book@example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
MAUTIC_EMAIL_FROM=mautic@example.com
CHATWOOT_EMAIL_FROM=support@example.com
SNAGTIME_EMAIL_FROM=book@example.com
EMAIL_REPLY_TO=book@example.com
EMAIL_SENDER_DOMAIN=example.com
CHATWOOT_INBOX_USER=support@example.com
# Bootstrap requires these documented provider API contracts. Tokens remain
# files under CUSTOMER_OPS_SECRETS_DIR, never values in this env file.
MAUTIC_CONTACT_TAG=blockwise-customer
MAUTIC_LIFECYCLE_TAG=blockwise-lifecycle
MAUTIC_LIFECYCLE_FIELDS_JSON={"activation_stage":"text","booking_status":"text","booking_subject":"text"}
MAUTIC_LIFECYCLE_SEGMENTS_JSON={"new":"replace-with-mautic-segment-id","active":"replace-with-mautic-segment-id"}
MAUTIC_LIFECYCLE_CAMPAIGNS_JSON={"new":"replace-with-mautic-campaign-id","active":"replace-with-mautic-campaign-id"}
SNAGTIME_IMAGE=ghcr.io/stevenshelley58-afk/snagtime-runtime:86f71128af79a0efc6eeac6003a40eb601ff7c4c@sha256:REPLACE_WITH_PUBLISHED_DIGEST
SNAGTIME_REVISION=86f71128af79a0efc6eeac6003a40eb601ff7c4c
# Optional smoke-test-only values, held outside git.
MAUTIC_API_URL=https://crm.example.com/api
BLOCKWISE_PRODUCT_ENV_FILE=/srv/blockwise/product/.env
CHATWOOT_API_URL=https://support.example.com/api/v1
CHATWOOT_ACCOUNT_ID=1
# Optional API bootstrap payload (operator-created, mode 0600, outside git).
# CHATWOOT_INBOX_PAYLOAD_FILE=/etc/blockwise/customer-ops/chatwoot-inbox.json
# CHATWOOT_WEBHOOK_URL=https://frank.example.com/api/customer-ops/chatwoot-webhook
# CHATWOOT_WEBHOOK_PROBE_URL=https://frank.example.com/api/customer-ops/chatwoot-webhook
FRANK_OPS_OVERVIEW_URL=https://frank.example.com/api/ops/overview
